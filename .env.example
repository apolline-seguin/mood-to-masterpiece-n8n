# Checklist of the credentials this project needs.
# The workflow runs on n8n Cloud, where you create them in
# Credentials > Create credential. Never commit a real .env file.

# Telegram API credential (token from @BotFather)
TELEGRAM_BOT_TOKEN=

# Groq API credential (console.groq.com > API Keys)
GROQ_API_KEY=

# Supabase API credential (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
