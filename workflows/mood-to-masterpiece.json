      "parameters": {
        "jsCode": "const chatId = $('Parse command').first().json.chatId;\nconst rows = $input.all().map(i => i.json).filter(r => r.mood);\nrows.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\nconst last = rows.slice(0, 5);\n\nlet text;\nif (last.length === 0) {\n  text = \"You have no mood history yet. Try /mood sad to get your first artwork!\";\n} else {\n  text = \"Your last \" + last.length + \" moods:\\n\\n\" +\n    last.map((r, i) => (i + 1) + \". \" + r.mood + \" - \" + r.title + \" by \" + r.artist).join(\"\\n\");\n}\nreturn [{ json: { chat_id: chatId, text } }];"
