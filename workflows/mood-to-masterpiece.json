    {
      "parameters": {
        "jsCode": "const parsed = $('Parse command').first().json;\nconst art = $('Find artwork').first().json;\nconst note = String($json.art_note || '').trim().slice(0, 600);\n\n// Telegram HTML mode: escape special characters\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst caption =\n`🎨 <b>${esc(art.title.slice(0, 100))}</b>\n${esc(art.artist.slice(0, 100))}, ${esc(art.date)}\n\n<i>${esc(note)}</i>\n\n🔗 <a href=\"${art.artworkUrl}\">See the artwork at the Cleveland Museum of Art</a>`;\n\nreturn [{\n  json: {\n    chat_id: parsed.chatId,\n    first_name: parsed.firstName,\n    mood: parsed.mood,\n    keyword: parsed.keyword,\n    artwork_id: art.artworkId,\n    title: art.title,\n    artist: art.artist,\n    image_url: art.imageUrl,\n    art_note: note,\n    caption\n  }\n}];"
      },
