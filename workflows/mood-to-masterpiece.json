    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\n\n// keep only artworks that have a web image\nconst works = (res.data || []).filter(a => a.images?.web?.url);\n\nif (works.length === 0) {\n  return [{ json: { found: false } }];\n}\n\nconst a = works[Math.floor(Math.random() * works.length)];\nconst creator = (a.creators && a.creators[0] && a.creators[0].description) || 'Unknown artist';\n\nreturn [{\n  json: {\n    found: true,\n    artworkId: a.id,\n    title: a.title || 'Untitled',\n    artist: creator.split('\\n')[0].trim(),\n    date: a.creation_date || 'date unknown',\n    imageUrl: a.images.web.url,\n    artworkUrl: a.url || 'https://www.clevelandart.org'\n  }\n}];"
      },
