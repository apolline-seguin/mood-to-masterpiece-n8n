    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message || {};\nconst text = String(msg.text || '').trim();\nconst chatId = msg.chat?.id;\nconst firstName = msg.from?.first_name || 'friend';\n\n// English mood -> English museum keywords (the museum catalogue is in English)\nconst dictionary = {\n  'sad': ['melancholy', 'sorrow', 'tears', 'rain'],\n  'melancholic': ['melancholy', 'twilight', 'solitude'],\n  'nostalgic': ['memory', 'childhood', 'old town', 'autumn'],\n  'happy': ['dance', 'celebration', 'sunshine', 'garden'],\n  'joyful': ['dance', 'festival', 'flowers', 'sunshine'],\n  'in love': ['lovers', 'kiss', 'romance', 'rose'],\n  'angry': ['storm', 'battle', 'fire', 'fury'],\n  'anxious': ['storm', 'night', 'fog', 'scream'],\n  'stressed': ['storm', 'crowd', 'night', 'fog'],\n  'scared': ['night', 'shadow', 'storm', 'ghost'],\n  'tired': ['sleep', 'rest', 'night', 'dream'],\n  'calm': ['lake', 'still life', 'moonlight', 'meadow'],\n  'peaceful': ['lake', 'garden', 'morning', 'water lilies'],\n  'lonely': ['solitude', 'lone', 'empty street', 'window'],\n  'curious': ['explorer', 'map', 'telescope', 'library'],\n  'dreamy': ['dream', 'clouds', 'moon', 'fantasy'],\n  'hopeful': ['sunrise', 'dawn', 'spring', 'bird'],\n  'proud': ['hero', 'portrait', 'crown', 'victory'],\n  'bored': ['waiting', 'empty room', 'afternoon', 'clock'],\n  'excited': ['carnival', 'parade', 'fireworks', 'dance'],\n  'grateful': ['harvest', 'feast', 'garden', 'sunlight']\n};\n\n// lower case, no accents, single spaces, no filler words like \"very\" or \"I am\"\nconst normalize = s => {\n  let t = s.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[’']/g, ' ').replace(/[^a-z\\s-]/g, ' ').replace(/\\s+/g, ' ').trim();\n  const filler = /^(i am|i m|im|feeling|feel|so|very|really|quite|a bit|super|extremely)\\s+/;\n  while (filler.test(t)) t = t.replace(filler, '');\n  return t;\n};\n\nlet command = 'unknown';\nlet rest = '';\nconst m = text.match(/^\\/(\\w+)(?:@\\w+)?\\s*([\\s\\S]*)$/);\nif (m) {\n  const cmd = m[1].toLowerCase();\n  rest = m[2];\n  if (cmd === 'mood') command = 'mood';\n  else if (cmd === 'history') command = 'history';\n  else if (cmd === 'help' || cmd === 'start') command = 'help';\n}\n\nlet mood = '';\nlet keyword = '';\nlet valid = false;\nif (command === 'mood') {\n  mood = normalize(rest);\n  valid = /[a-z]{3,}/.test(mood) && mood.length <= 40;\n  if (valid) {\n    const options = dictionary[mood];\n    keyword = options ? options[Math.floor(Math.random() * options.length)] : mood;\n  }\n}\n\nreturn [{ json: { chatId, firstName, text, command, mood, keyword, valid } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -128,
